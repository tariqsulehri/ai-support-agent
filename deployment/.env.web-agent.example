# ── Core ────────────────────────────────────────────────
NODE_ENV=production

# OpenAI (fallback when a tenant has no per-tenant key configured)
OPENAI_API_KEY=your_openai_api_key_here

# Key used to encrypt/decrypt tenant-owned secrets at rest (tenant_secrets)
PLATFORM_ENCRYPTION_KEY=your_platform_encryption_key_here

# Session/auth secret for admin + tenant login
AUTH_SECRET=your_auth_secret_here

# ── MongoDB (installed directly on this VM, not containerized) ──
# host.docker.internal resolves to the VM host via the extra_hosts entry in docker-compose.yml
# URL-encode special characters in the password (e.g. # -> %23)
MONGODB_URI=mongodb://user:password@host.docker.internal:27017/voiceagent?authSource=admin
MONGODB_DB_NAME=voiceagent
MONGODB_CALLS_COLLECTION=conversations

# ── ElevenLabs (only required for tenants with ttsProvider: elevenlabs) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── Embed security ─────────────────────────────────────
EMBED_AUTH_ENABLED=true
ALLOWED_FRAME_ANCESTORS=https://ai-script-web-site.vercel.app https://www.aiscripto.com https://aiscripto.com

# ── Email notifications (call summaries / leads) ───────
SERVICE=
EMAIL_USER=
EMAIL_PASS=
HOST=
EMAIL_PORT=

# ── Dashboard protection ───────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me

# ── Platform observability / enforcement toggles ───────
AUDIT_LOGS_ENABLED=false
USAGE_EVENTS_ENABLED=false
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
TENANT_RATE_LIMIT_ENABLED=false
TENANT_RATE_LIMIT_WINDOW_SECONDS=60
